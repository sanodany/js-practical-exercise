/*Write a function removeHighestOccurrence that takes an array of elements as an argument and returns a new array with the highest occurring element removed. 

removeHighestOccurrence([1, 2, 2, 3, 4, 4, 5]) // [1, 3, 5]

removeHighestOccurrence(['a', 'b', 'b', 'c', 'c', 'c', 'd']) // ['a', 'b', 'b', 'd']

removeHighestOccurrence([true, true, false, false, true]) // [false, false]
*/
function removeHighestOccurrence(arr){
    let count = {}
    let result = []
    let highestOccurence = 0
    for(let i=0;i<arr.length;i++){
        count[arr[i]] =  (count[arr[i]] || 0) + 1
    }
    for (let key in count){
        if(count[key]>highestOccurence){
            highestOccurence = count[key]
        }
    }
    for (let key of arr){
        if (count[key] !== highestOccurence){
            result.push(key)
        }
    }
    return result
    
}
console.log(removeHighestOccurrence(['a', 'b', 'b', 'c', 'c', 'c', 'd']))
console.log(removeHighestOccurrence([1, 2, 2, 3, 4, 4, 5]))
console.log(removeHighestOccurrence([true, true, false, false, true]))

